# Project Metadata
PROJECT_NAME="tmath AI Diagnostic & Admin Dashboard Service"
API_V1_STR="/api/v1"

# Backup Directory Configuration
BACKUP_DIR=backup

# External source DB (SELECT only). For local-source Docker profile, use host db.
SOURCE_DB_HOST=db
SOURCE_DB_PORT=3306
SOURCE_DB_USER=tmath_dashboard_reader
SOURCE_DB_PASSWORD=replace-with-source-reader-password
SOURCE_DB_NAME=dmoj
SOURCE_DB_PUBLISHED_PORT=3306
# Root credential for the optional local source fixture, never used by the backend.
SOURCE_FIXTURE_ROOT_PASSWORD=replace-with-local-source-root-password

# Dashboard-owned DB. Container port is 3306; host port is 3307.
DASHBOARD_DB_HOST=dashboard-db
DASHBOARD_DB_PORT=3306
DASHBOARD_DB_NAME=tmath_dashboard
DASHBOARD_DB_USER=tmath_dashboard_app
DASHBOARD_DB_PASSWORD=replace-with-dashboard-app-password
DASHBOARD_DB_PUBLISHED_PORT=3307
DASHBOARD_ROOT_PASSWORD=replace-with-dashboard-root-password

# Deployment/migration credentials, masked out of the backend container.
DASHBOARD_MIGRATION_USER=tmath_dashboard_migrator
DASHBOARD_MIGRATION_PASSWORD=replace-with-dashboard-migration-password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================================================
# LLM ENGINE CONFIGURATION
# ==============================================================================
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=hf.co/empero-ai/Qwen3.8-4B-GGUF:Q4_K_M
LLM_API_KEY=ollama

# ==============================================================================
# LLM HYPERPARAMETERS & SAMPLING CONFIGURATION
# ==============================================================================
LLM_TEMPERATURE=0.2          # Mức độ sáng tạo (0.0: Chính xác/Code, 1.0: Sáng tạo văn bản)
LLM_MAX_TOKENS=2048          # Số lượng token tối đa sinh ra trong 1 câu trả lời
LLM_TOP_P=0.95               # Nucleus sampling probability
LLM_CONTEXT_WINDOW=8192      # Kích thước cửa sổ ngữ cảnh tối đa (Context Window / num_ctx)

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
