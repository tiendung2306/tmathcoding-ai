# Project Metadata
PROJECT_NAME="tmath AI Diagnostic & Admin Dashboard Service"
API_V1_STR="/api/v1"
# Source super-admin profile linked to the single dashboard admin account.
DASHBOARD_ADMIN_PROFILE_ID=2
# Set false only for local HTTP development. Production must use HTTPS.
AUTH_COOKIE_SECURE=false

# Credentials for the optional local source fixture/API mock and the offline
# import_legacy operator command. The dashboard backend does not receive these.
# For local-source Docker profile, the API mock connects to host db.
SOURCE_DB_HOST=db
SOURCE_DB_PORT=3306
SOURCE_DB_USER=tmath_dashboard_reader
SOURCE_DB_PASSWORD=replace-with-source-reader-password
SOURCE_DB_NAME=dmoj
# For the local source-api-mock. In deployment, use the provider's HTTPS URL and token.
SOURCE_API_BASE_URL=http://source-api-mock:8001/integration/v1
SOURCE_API_TOKEN=replace-with-source-api-token
SOURCE_API_TIMEOUT_SECONDS=8
# Reuse a granted source-admin check for N seconds (0 = re-check every request).
SOURCE_ACCESS_CACHE_SECONDS=0
# Root credential for the optional local source fixture, never used by the backend.
SOURCE_FIXTURE_ROOT_PASSWORD=replace-with-local-source-root-password

# Dashboard-owned DB. Container port is 3306; host port is 3307.
DASHBOARD_DB_HOST=dashboard-db
DASHBOARD_DB_PORT=3306
DASHBOARD_DB_NAME=tmath_dashboard
DASHBOARD_DB_USER=tmath_dashboard_app
DASHBOARD_DB_PASSWORD=replace-with-dashboard-app-password
DASHBOARD_DB_PUBLISHED_PORT=3307
DASHBOARD_ROOT_PASSWORD=replace-with-dashboard-root-password

# Deployment/migration credentials, masked out of the backend container.
DASHBOARD_MIGRATION_USER=tmath_dashboard_migrator
DASHBOARD_MIGRATION_PASSWORD=replace-with-dashboard-migration-password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================================================
# LLM ENGINE CONFIGURATION
# ==============================================================================
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=hf.co/empero-ai/Qwen3.8-4B-GGUF:Q4_K_M
LLM_API_KEY=ollama

# ==============================================================================
# LLM HYPERPARAMETERS & SAMPLING CONFIGURATION
# ==============================================================================
LLM_TEMPERATURE=0.2          # Mức độ sáng tạo (0.0: Chính xác/Code, 1.0: Sáng tạo văn bản)
LLM_MAX_TOKENS=2048          # Số lượng token tối đa sinh ra trong 1 câu trả lời
LLM_TOP_P=0.95               # Nucleus sampling probability
LLM_CONTEXT_WINDOW=8192      # Kích thước cửa sổ ngữ cảnh tối đa (Context Window / num_ctx)

# ==============================================================================
# CODE DOCTOR (để trống để dùng chung cấu hình LLM_* ở trên)
# Code Doctor đọc cả mã học sinh và mã AC tham chiếu, nên cần model mạnh hơn và
# cửa sổ ngữ cảnh lớn hơn auto-tag. Ví dụ dùng API tương thích OpenAI:
#   DOCTOR_LLM_PROVIDER=openai_compatible
#   DOCTOR_LLM_BASE_URL=https://api.example.com/v1
#   DOCTOR_LLM_API_KEY=<khóa API>
#   DOCTOR_LLM_MODEL=<tên model>
#   DOCTOR_LLM_CONTEXT_WINDOW=32768
# ==============================================================================
DOCTOR_LLM_PROVIDER=
DOCTOR_LLM_BASE_URL=
DOCTOR_LLM_API_KEY=
DOCTOR_LLM_MODEL=
DOCTOR_LLM_CONTEXT_WINDOW=0
DOCTOR_LLM_MAX_TOKENS=1800
DOCTOR_LLM_TIMEOUT_SECONDS=150

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
